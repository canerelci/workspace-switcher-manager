<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="workspace-switcher-manager">
  <schema id="org.gnome.shell.extensions.workspace-switcher-manager" path="/org/gnome/shell/extensions/workspace-switcher-manager/">
    <key type="i" name="popup-visibility">
      <default>1</default>
    </key>

    <key type="b" name="reverse-ws-orientation">
      <default>false</default>
    </key>

    <key type="b" name="ws-wraparound">
      <default>false</default>
    </key>
    <key type="b" name="ws-ignore-last">
      <default>false</default>
    </key>

    <key type="b" name="pointer-workspace-select-enabled">
      <default>false</default>
      <summary>Show workspace switcher on shortcut and switch by mouse</summary>
      <description>When enabled, the configured shortcut opens only the workspace switcher popup so you can click a workspace to activate it.</description>
    </key>

    <key type="i" name="pointer-workspace-select-hotkey-preset">
      <default>0</default>
      <summary>Preset for pointer-select shortcut</summary>
      <description>0 = Super+W and Super+Tab; 1 = Super+W only; 2 = Super+Tab only.</description>
    </key>

    <key type="as" name="pointer-workspace-select-accelerator">
      <default><![CDATA[['<Super>w', '<Super>Tab']]]></default>
      <summary>Accelerator for pointer-select workspace popup</summary>
      <description>Keybinding that opens the workspace switcher for mouse selection (stored as an accelerator array).</description>
    </key>

    <key type="b" name="pointer-workspace-select-persist-until-click">
      <default>true</default>
      <summary>Keep pointer-select popup until you click a workspace</summary>
      <description>When enabled, the pointer-select popup stays open until you click a workspace (no timer while keys are released). When disabled, normal on-screen time and modifier-key rules apply.</description>
    </key>

    <key type="b" name="pointer-workspace-select-debug-overlay">
      <default>false</default>
      <summary>Show debug overlay on pointer-select popup</summary>
      <description>When enabled, a small panel shows pointer position, stage pick targets, and enter/leave log; includes a Copy button for diagnostics.</description>
    </key>

    <key type="i" name="popup-mode">
      <default>0</default>
    </key>
    <key type="i" name="monitor">
      <default>0</default>
    </key>
    <key type="i" name="on-screen-time">
      <default>600</default>
    </key>
    <key type="i" name="fade-out-time">
      <default>200</default>
    </key>
    <key type="b" name="modifiers-hide-popup">
      <default>true</default>
    </key>

    <key type="i" name="horizontal">
      <default>50</default>
    </key>
    <key type="i" name="vertical">
      <default>50</default>
    </key>

    <key type="b" name="reverse-popup-orientation">
      <default>false</default>
    </key>


    <key type="i" name="popup-scale">
      <default>100</default>
    </key>
    <key type="i" name="popup-width-scale">
      <default>100</default>
    </key>
    <key type="i" name="popup-height-scale">
      <default>100</default>
      <summary>Workspace box height scale</summary>
      <description>Adjusts vertical size of each workspace tile relative to width (100 matches width-derived ratio). Higher values shorten tiles; lower values make them taller.</description>
    </key>
    <key type="i" name="popup-padding-scale">
      <default>100</default>
    </key>
    <key type="i" name="popup-spacing-scale">
      <default>100</default>
    </key>
    <key type="i" name="popup-radius-scale">
      <default>100</default>
    </key>

    <key type="i" name="font-scale">
      <default>100</default>
    </key>
    <key type="i" name="index-scale">
      <default>100</default>
    </key>
    <key type="i" name="popup-label-padding-scale">
      <default>55</default>
      <summary>Workspace label horizontal padding</summary>
      <description>Side padding inside workspace text as a percentage of the default (100 = original). Lower values give labels more width before wrapping.</description>
    </key>

    <key type="b" name="wrap-app-names">
      <default>true</default>
    </key>
    <key type="b" name="text-shadow">
      <default>false</default>
    </key>
    <key type="b" name="text-bold">
      <default>true</default>
    </key>


    <key type="i" name="popup-opacity">
      <default>100</default>
    </key>

    <key type="s" name="popup-bg-color">
      <default>'rgb(29,29,29)'</default>
    </key>
    <key type="s" name="popup-border-color">
      <default>'rgb(53,53,53)'</default>
    </key>
    <key type="s" name="popup-active-fg-color">
      <default>'rgb(255,255,255)'</default>
    </key>
    <key type="s" name="popup-active-bg-color">
      <default>'rgb(0,110,255)'</default>
    </key>
    <key type="s" name="popup-inactive-fg-color">
      <default>'rgb(255,255,255)'</default>
    </key>
    <key type="s" name="popup-inactive-bg-color">
      <default>'rgb(29,29,29)'</default>
    </key>

    <key type="s" name="popup-inactive-hover-bg-color">
      <default>'rgba(255,255,255,0.22)'</default>
      <summary>Inactive workspace hover background</summary>
      <description>Background highlight when the pointer hovers an inactive workspace tile (pointer-select session).</description>
    </key>
    <key type="s" name="popup-inactive-hover-border-color">
      <default>'rgba(255,255,255,0.72)'</default>
      <summary>Inactive workspace hover border</summary>
      <description>Border color when the pointer hovers an inactive workspace tile (pointer-select session).</description>
    </key>
    <key type="s" name="popup-active-hover-glow-color">
      <default>'rgba(255,255,255,0.55)'</default>
      <summary>Active workspace hover glow</summary>
      <description>Glow color around the active workspace tile when hovered (pointer-select session).</description>
    </key>

    <key type="b" name="popup-workspace-thumbnails">
      <default>false</default>
      <summary>Show workspace thumbnails in indicator boxes</summary>
      <description>When enabled, each workspace tile shows a scaled live preview of that workspace (custom pop-up layout).</description>
    </key>


    <key type="b" name="active-show-ws-index">
      <default>true</default>
    </key>
    <key type="b" name="active-show-ws-name">
      <default>false</default>
    </key>
    <key type="b" name="active-show-app-name">
      <default>true</default>
    </key>
    <key type="b" name="active-show-win-title">
